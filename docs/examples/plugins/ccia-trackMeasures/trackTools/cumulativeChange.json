{
  "task": "cumulativeChange",
  "fun_name": "trackTools.cumulativeChange",
  "label": "Cumulative change",
  "category": "trackTools",
  "env": ["local"],
  "resource_pool": "cpu",
  "scope": "image",
  "outputValueName": "default",
  "tests": [
    {
      "name": "straightness is a fraction, and no cell is lost",
      "fixture": {"properties": ["cells", "movie", "tracked"]},
      "params": {"pops": ["B/_tracked"], "gap": 3},
      "outputs": [
        {"cells": "B", "assert": [
          {"type": "mean_measure", "column": "trackTools.cumulativeStraightness", "min": 0, "max": 1},
          {"type": "mean_measure", "column": "trackTools.cumulativeSpeed", "min": 0},
          {"type": "n_labels", "value": 1377}
        ]}
      ]
    }
  ],
  "params": [
    {
      "key": "pops",
      "label": "Track populations",
      "type": "popSelection",
      "accepts": ["track", "trackclust"],
      "multiple": true,
      "acrossSegmentations": false,
      "required": true,
      "requiredMessage": "Select at least one track population",
      "default": [],
      "tip": "Tracks to measure; the whole set is the segmentation's tracked pop"
    },
    {
      "key": "gap",
      "label": "Gap",
      "type": "int",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 3,
      "tip": "Positions to look back along each track; larger smooths out jitter"
    }
  ]
}
