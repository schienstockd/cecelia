{
  "task": "cumulativeChange",
  "fun_name": "trackTools.cumulativeChange",
  "label": "Cumulative change",
  "category": "trackTools",
  "env": ["local"],
  "resource_pool": "cpu",
  "scope": "image",
  "outputValueName": "default",
  "params": [
    {
      "key": "valueName",
      "label": "Segmentation",
      "type": "valueNameSelection",
      "default": "default",
      "tip": "Which tracked segmentation to measure"
    },
    {
      "key": "gap",
      "label": "Gap",
      "type": "int",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 3,
      "tip": "Positions to look back along each track; larger smooths out jitter"
    }
  ]
}
