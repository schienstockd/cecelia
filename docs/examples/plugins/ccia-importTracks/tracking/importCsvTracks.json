{
  "task": "importCsvTracks",
  "fun_name": "tracking.importCsvTracks",
  "label": "Import external tracks",
  "category": "tracking",
  "env": [
    "local"
  ],
  "resource_pool": "cpu",
  "scope": "image",
  "outputValueName": "default",
  "params": [
    {
      "key": "valueName",
      "label": "Segmentation",
      "type": "valueNameSelection",
      "default": "default",
      "tip": "Which segmentation the tracks attach to"
    },
    {
      "key": "csvPath",
      "label": "Track file",
      "type": "filePath",
      "default": "",
      "required": true,
      "tip": "TrackMate XML, or a delimited table — its columns fill the mapping below",
      "triggersOptions": true,
      "extensions": [
        ".xml",
        ".csv",
        ".tsv",
        ".txt"
      ],
      "placeholder": "Browse for the exported track file"
    },
    {
      "key": "template",
      "label": "Exported from",
      "type": "select",
      "default": "imagej_manual",
      "options": [
        {
          "value": "imagej_manual",
          "label": "ImageJ Manual Tracking"
        },
        {
          "value": "trackmate_xml",
          "label": "TrackMate (track XML)"
        },
        {
          "value": "trackmate",
          "label": "TrackMate"
        },
        {
          "value": "imaris",
          "label": "Imaris"
        },
        {
          "value": "custom",
          "label": "Custom (map columns below)"
        }
      ],
      "tip": "Preset column mapping; XML needs none"
    },
    {
      "key": "maxDistance",
      "label": "Match distance (px)",
      "type": "float",
      "min": 0.5,
      "max": 200,
      "step": 0.5,
      "default": 10,
      "tip": "Cells further than this from any spot stay untracked"
    },
    {
      "key": "columnMapping",
      "label": "Column mapping",
      "type": "section",
      "collapsed": true,
      "params": [
        {
          "key": "trackColumn",
          "label": "Track id",
          "type": "select",
          "default": "",
          "tip": "Column holding the track id",
          "options": []
        },
        {
          "key": "frameColumn",
          "label": "Frame",
          "type": "select",
          "default": "",
          "tip": "Column holding the frame/slice",
          "options": []
        },
        {
          "key": "xColumn",
          "label": "X",
          "type": "select",
          "default": "",
          "tip": "Column holding X",
          "options": []
        },
        {
          "key": "yColumn",
          "label": "Y",
          "type": "select",
          "default": "",
          "tip": "Column holding Y",
          "options": []
        },
        {
          "key": "zColumn",
          "label": "Z",
          "type": "select",
          "default": "",
          "tip": "Column holding Z (leave empty for 2D)",
          "options": []
        },
        {
          "key": "frameBase",
          "label": "First frame is",
          "type": "select",
          "default": "1",
          "tip": "Which number the file calls the first frame",
          "options": [
            {
              "value": "0",
              "label": "0 (first frame is 0)"
            },
            {
              "value": "1",
              "label": "1 (first frame is 1)"
            }
          ]
        },
        {
          "key": "skipRows",
          "label": "Skip rows",
          "type": "int",
          "min": 0,
          "max": 20,
          "step": 1,
          "default": 0,
          "tip": "Lines above the header row (Imaris writes 3)",
          "triggersOptions": true
        },
        {
          "key": "spotUnit",
          "label": "Coordinates in",
          "type": "select",
          "default": "physical",
          "options": [
            {
              "value": "physical",
              "label": "Calibrated (µm)"
            },
            {
              "value": "pixel",
              "label": "Pixels"
            }
          ],
          "tip": "How the file stores X/Y/Z"
        }
      ]
    }
  ]
}
