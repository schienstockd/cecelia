{
  "id": "transition_matrix",
  "label": "Transition matrix",
  "module": "behaviourAnalysis",
  "family": "summary",
  "chartTypes": ["heatmap"],
  "whiteboardCompatible": true,
  "dataSource": {
    "popTypes": [
      { "popType": "live",       "granularity": "cell" },
      { "popType": "track",      "granularity": "cell" },
      { "popType": "trackclust", "granularity": "cell" }
    ],
    "obsMeasurePatterns": [
      { "match": "hmm.transitions.", "label": "HMM transitions" }
    ],
    "matrix": { "mode": "crosstab", "category": "live.cell.hmm.transitions.movement" }
  },
  "scopeModes": ["per_image", "summarised"]
}
