{
  "id": "spatial_pattern_summary",
  "label": "Spatial pattern by group",
  "category": "compare",
  "answers": "Is a population clustered or dispersed among the tissue's cells, compared between treatments?",
  "module": "spatialAnalysis",
  "family": "summary",
  "chartTypes": ["boxplot", "strip", "bar"],
  "whiteboardCompatible": true,
  "dataSource": {
    "popTypes": [
      { "popType": "flow", "granularity": "cell", "label": "Gated" },
      { "popType": "clust", "granularity": "cell" },
      { "popType": "region", "granularity": "cell" },
      { "popType": "live", "granularity": "cell", "label": "Tracked" },
      { "popType": "track", "granularity": "cell", "label": "Tracked (gated)" },
      { "popType": "trackclust", "granularity": "cell", "label": "Track clusters" }
    ],
    "imageMetric": { "source": "spatialPattern", "task": "Spatial pattern", "pickPops": true },
    "measure": "nnRatio",
    "measureOptions": ["nnRatio", "ceR", "zScore"],
    "measureLabels": { "nnRatio": "NN ratio", "ceR": "Clark–Evans R", "zScore": "z-score" }
  },
  "scopeModes": ["summarised", "by_attr"],
  "params": []
}
