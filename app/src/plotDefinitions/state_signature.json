{
  "id": "state_signature",
  "label": "State signature",
  "module": "behaviourAnalysis",
  "family": "summary",
  "chartTypes": ["heatmap"],
  "whiteboardCompatible": true,
  "dataSource": {
    "popTypes": [
      { "popType": "live",       "granularity": "cell" },
      { "popType": "track",      "granularity": "cell" },
      { "popType": "trackclust", "granularity": "cell" }
    ],
    "measure": "live.cell.speed",
    "measureOptions": [
      "live.cell.speed",
      "live.cell.angle"
    ],
    "matrix": { "mode": "profile", "category": "live.cell.hmm.state.movement" }
  },
  "scopeModes": ["per_image", "summarised"]
}
