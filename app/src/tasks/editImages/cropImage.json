{
  "task": "cropImage",
  "fun_name": "editImages.cropImage",
  "label": "Crop image",
  "category": "Edit",
  "env": [
    "local"
  ],
  "resource_pool": "io",
  "outputValueName": "default",
  "params": [
    {
      "key": "valueName",
      "label": "Source image",
      "type": "valueNameSelection",
      "default": "default",
      "field": "filepaths",
      "tip": "Which image version to crop"
    },
    {
      "key": "cropBox",
      "label": "Crop area",
      "type": "imagePicker",
      "geometry": "box3d",
      "required": true,
      "default": null,
      "tip": "Draw the region to keep; z/t unset = keep whole axis"
    }
  ]
}
