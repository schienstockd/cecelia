{
  "task": "measureLabels",
  "fun_name": "segment.measureLabels",
  "label": "Measure labels",
  "category": "Segment",
  "env": ["local"],
  "resource_pool": "cpu",
  "qcPlot": "segmentation_qc",
  "params": [
    {
      "key": "outputValueName",
      "label": "Label set to measure",
      "type": "valueNameSelection",
      "field": "labels",
      "default": "default",
      "tip": "Which label set to measure"
    },
    {
      "key": "intensityValueName",
      "label": "Image for intensities",
      "type": "valueNameSelection",
      "default": "default",
      "tip": "Which image version to measure intensities from"
    },
    {
      "key": "measureOptions",
      "label": "Measurement options",
      "type": "section",
      "collapsed": false,
      "params": [
        {
          "key": "intensityMeasure",
          "label": "Intensity measure",
          "type": "select",
          "default": "mean",
          "tip": "Statistic to use for per-channel intensity measurement",
          "options": [
            { "label": "Mean",   "value": "mean"   },
            { "label": "Median", "value": "median" }
          ]
        },
        {
          "key": "gaussianFilter",
          "label": "Gaussian pre-smooth (σ)",
          "type": "float",
          "min": 0.0,
          "max": 10.0,
          "step": 0.5,
          "default": 0.0,
          "tip": "Gaussian blur sigma applied to the image before intensity measurement (0 = off)"
        },
        {
          "key": "extendedMeasures",
          "label": "Extended 3D measures",
          "type": "bool",
          "default": false,
          "tip": "3D shape descriptors (surface area, sphericity, …); slow"
        }
      ]
    },
    {
      "key": "imageTiling",
      "label": "Image tiling",
      "type": "section",
      "collapsed": true,
      "params": [{"$include": "imageTiling"}]
    }
  ]
}
