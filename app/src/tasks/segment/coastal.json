{
  "task": "coastalSegment",
  "fun_name": "segment.coastal",
  "label": "Optical flow segmentation",
  "category": "Segment",
  "env": [
    "local"
  ],
  "resource_pool": "gpu",
  "requires": {
    "axes": [
      "T"
    ],
    "scale": [
      "xy",
      "t"
    ]
  },
  "params": [
    {
      "key": "valueName",
      "label": "Image to segment",
      "type": "valueNameSelection",
      "default": "default",
      "tip": "Usually the smoothed version — flow needs a denoised input"
    },
    {
      "key": "outputValueName",
      "label": "Output label name",
      "type": "valueNameInput",
      "namespace": "labels",
      "default": "default",
      "tip": "Name for the output label set"
    },
    {
      "key": "models",
      "label": "Segmentation models",
      "type": "group",
      "repeatable": true,
      "entriesTip": "Passes run in order — each labels only what earlier passes left, so pass 1 needs its seed blur or pass 2 finds nothing",
      "entryDefaults": [
        {},
        {
          "seedSize": 2.65,
          "affinityThreshold": 0.8,
          "mergeAffinityThreshold": 0.9,
          "seedBlurSigma": 0.0,
          "minComponentSize": 1.1
        }
      ],
      "default": {
        "0": {
          "model": "",
          "matchAs": "base",
          "cellChannels": [],
          "normalise": 99.99,
          "seedSize": 4.0,
          "seedBlurSigma": 2.5,
          "probThreshold": 0.3,
          "affinityThreshold": 0.5,
          "minComponentSize": 2.0,
          "stitchThreshold": 0.2,
          "probBlurSigma": 0.0,
          "embeddingBlurSigma": 1.5,
          "mergeAffinityThreshold": 0.65,
          "mergeMaxDistance": 0.5,
          "probWeight": 0.3,
          "maxIter": 200
        }
      },
      "tip": "Add a second entry to run a second pass; it fills gaps the first left",
      "params": [
        {
          "key": "model",
          "vis": "text",
          "optionsFrom": "coastalModels",
          "label": "Model",
          "type": "select",
          "field": "models",
          "default": "",
          "tip": "Trained on the Optical Flow page",
          "options": [
            {
              "label": "None",
              "value": ""
            }
          ]
        },
        {
          "key": "matchAs",
          "vis": "text",
          "label": "Match as",
          "type": "select",
          "default": "base",
          "tip": "Role of this model's output; one 'base' + one 'nuc' to pair",
          "options": [
            {
              "label": "Base (primary)",
              "value": "base"
            },
            {
              "label": "Nucleus",
              "value": "nuc"
            }
          ]
        },
        {
          "key": "cellChannels",
          "vis": "text",
          "label": "Cell channels",
          "type": "channelSelection",
          "multiple": true,
          "default": [],
          "tip": "Channels carrying the cell signal; merged by maximum"
        },
        {
          "key": "seedSize",
              "vis": "diameter",
          "label": "Seed window (µm)",
          "type": "float",
          "min": 0.5,
          "max": 30.0,
          "step": 0.5,
          "default": 4.0,
          "tip": "How close two cells may be and still get separate seeds"
        },
        {
          "key": "probThreshold",
              "vis": "fraction",
          "label": "Foreground threshold",
          "type": "float",
          "min": 0.05,
          "max": 0.95,
          "step": 0.05,
          "default": 0.3,
          "tip": "Cutoff on the probability map; raise to ignore dim regions"
        },
        {
          "key": "advanced",
          "label": "Advanced",
          "type": "section",
          "collapsed": true,
          "params": [
            {
              "key": "seedBlurSigma",
              "vis": "blur",
              "label": "Seed blur (µm)",
              "type": "float",
              "min": 0.0,
              "max": 10.0,
              "step": 0.25,
              "default": 2.5,
              "tip": "Raise to merge fragments of one cell; does not move the outline"
            },
            {
              "key": "affinityThreshold",
              "vis": "fraction",
              "label": "Growing threshold",
              "type": "float",
              "min": 0.1,
              "max": 0.9,
              "step": 0.05,
              "default": 0.5,
              "tip": "Embedding similarity needed to grow into a pixel"
            },
            {
              "key": "minComponentSize",
              "vis": "area",
              "label": "Min fragment (µm²)",
              "type": "float",
              "min": 0.0,
              "max": 100.0,
              "step": 0.5,
              "default": 2.0,
              "tip": "Remove grown fragments below this area"
            },
            {
              "key": "normalise",
              "label": "Normalise percentile",
              "type": "float",
              "min": 50.0,
              "max": 100.0,
              "step": 0.01,
              "default": 99.99,
              "tip": "Upper percentile for intensity normalisation"
            },
            {
              "key": "stitchThreshold",
              "vis": "fraction",
              "label": "Z-stitch threshold",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "step": 0.05,
              "default": 0.2,
              "tip": "IoU for matching labels across Z (3D only); 0 leaves every plane independent"
            },
            {
              "key": "probBlurSigma",
              "vis": "blur",
              "label": "Probability blur (µm)",
              "type": "float",
              "min": 0.0,
              "max": 5.0,
              "step": 0.25,
              "default": 0.0,
              "tip": "Measured to not fix the border; prefer smoothing the outlines"
            },
            {
              "key": "embeddingBlurSigma",
              "vis": "blur",
              "label": "Embedding blur (µm)",
              "type": "float",
              "min": 0.0,
              "max": 3.0,
              "step": 0.25,
              "default": 1.5,
              "tip": "Calibrated at 1.5; larger merges more and shrinks cells onto their bright cores"
            },
            {
              "key": "mergeAffinityThreshold",
              "vis": "fraction",
              "label": "Merge threshold",
              "type": "float",
              "min": 0.1,
              "max": 0.95,
              "step": 0.05,
              "default": 0.65,
              "tip": "Similarity needed to merge two fragments"
            },
            {
              "key": "mergeMaxDistance",
              "vis": "distance",
              "label": "Merge distance (µm)",
              "type": "float",
              "min": 0.0,
              "max": 5.0,
              "step": 0.25,
              "default": 0.5,
              "tip": "How far apart fragments may be to merge"
            },
            {
              "key": "probWeight",
              "vis": "fraction",
              "label": "Brightness relaxation",
              "type": "float",
              "min": 0.0,
              "max": 0.5,
              "step": 0.05,
              "default": 0.3,
              "tip": "Relaxes the growing threshold in bright regions"
            },
            {
              "key": "maxIter",
              "label": "Growing iterations",
              "type": "int",
              "min": 10,
              "max": 1000,
              "step": 10,
              "default": 200,
              "tip": "Upper bound; growing usually stops earlier"
            }
          ]
        }
      ]
    },
    {
      "key": "labelSmoothing",
      "label": "Smooth outlines (µm)",
      "type": "float",
      "min": 0.0,
      "max": 3.0,
      "step": 0.25,
      "default": 0.5,
      "tip": "Round the growing frontier's coastline; 0 = raw"
    },
    {
      "key": "temporalScaleMode",
      "label": "Temporal scale",
      "type": "select",
      "default": "frames",
      "tip": "Match durations when this movie's frame rate differs from the model's",
      "options": [
        {
          "label": "As trained",
          "value": "frames"
        },
        {
          "label": "Match durations",
          "value": "seconds"
        }
      ]
    },
    {
      "key": "labelModifications",
      "label": "Label modifications",
      "type": "section",
      "collapsed": true,
      "params": [
        {
          "key": "matchThreshold",
          "label": "Nuc-base match threshold",
          "type": "float",
          "min": 0.0,
          "max": 1.0,
          "step": 0.05,
          "default": 0.3,
          "tip": "IoU for matching nucleus labels to base labels"
        },
        {
          "key": "removeUnmatched",
          "label": "Remove unmatched cells",
          "type": "bool",
          "default": false,
          "tip": "Remove base cells that have no matching nucleus (only with nuc+base pair)"
        },
        {
          "key": "minCellSize",
          "label": "Min cell size (µm²)",
          "type": "float",
          "min": 0.0,
          "max": 1000.0,
          "step": 1.0,
          "default": 0.0,
          "tip": "Remove objects smaller than this area (0 = off)"
        },
        {
          "key": "cellSizeMax",
          "label": "Max cell size (µm²)",
          "type": "float",
          "min": 0.0,
          "max": 10000.0,
          "step": 10.0,
          "default": 0.0,
          "tip": "Remove objects larger than this area (0 = off)"
        },
        {
          "key": "labelExpansion",
          "label": "Label expansion (µm)",
          "type": "float",
          "min": 0.0,
          "max": 10.0,
          "step": 0.25,
          "default": 0.0,
          "tip": "Expand label boundaries outward (0 = off)"
        },
        {
          "key": "labelErosion",
          "label": "Label erosion (µm)",
          "type": "float",
          "min": 0.0,
          "max": 10.0,
          "step": 0.25,
          "default": 0.0,
          "tip": "Erode label boundaries inward (0 = off)"
        },
        {
          "key": "clearTouchingBorder",
          "label": "Clear border cells",
          "type": "bool",
          "default": false,
          "tip": "Remove cells that touch the XY image border"
        },
        {
          "key": "clearDepth",
          "label": "Clear Z-depth cells",
          "type": "bool",
          "default": false,
          "tip": "Remove cells touching the first or last Z slice"
        }
      ]
    },
    {
      "key": "imageTiling",
      "label": "Image tiling",
      "type": "section",
      "collapsed": true,
      "params": [
        {
          "$include": "imageTiling"
        },
        {
          "key": "labelOverlap",
          "label": "Seam stitch threshold",
          "type": "float",
          "min": 0.0,
          "max": 1.0,
          "step": 0.05,
          "default": 0.0,
          "tip": "IoU for stitching cells split at a tile seam (0 = max merge)"
        }
      ]
    },
    {
      "key": "segmentationOptions",
      "label": "Segmentation options",
      "type": "section",
      "collapsed": true,
      "params": [
        {
          "key": "normaliseToWhole",
          "label": "Global normalisation",
          "type": "bool",
          "default": true,
          "tip": "Keep on — per-tile scaling breaks the trained photometric range"
        }
      ]
    }
  ]
}
