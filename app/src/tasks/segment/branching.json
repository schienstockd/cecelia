{
  "task": "branching",
  "fun_name": "segment.branching",
  "label": "Branching (skeleton) analysis",
  "category": "Segment",
  "env": ["local"],
  "resource_pool": "cpu",
  "params": [
    {
      "key": "valueName",
      "label": "Segmentation",
      "type": "valueNameSelection",
      "field": "labels",
      "default": "default"
    },
    {
      "key": "outputValueName",
      "label": "Output name",
      "type": "text",
      "default": "default"
    },
    {
      "key": "refPops",
      "label": "Restrict to population",
      "type": "popSelection",
      "accepts": ["live", "clust", "region"],
      "default": "NONE"
    },
    {
      "key": "preDilationSize",
      "label": "Pre-dilation",
      "type": "int",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 2
    },
    {
      "key": "postDilationSize",
      "label": "Post-dilation",
      "type": "int",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 2
    },
    {
      "key": "useBorders",
      "label": "Use label boundaries",
      "type": "bool",
      "default": false
    },
    {
      "key": "flattenBranching",
      "label": "Flatten Z",
      "type": "bool",
      "default": false
    },
    {
      "key": "calcAnisotropy",
      "label": "Anisotropy",
      "type": "bool",
      "default": false
    },
    {
      "key": "calcFlattened",
      "label": "Anisotropy on Z-MIP",
      "type": "bool",
      "default": false
    },
    {
      "key": "fibreChannels",
      "label": "Fibre channels",
      "type": "channelSelection",
      "multiple": true,
      "default": []
    },
    {
      "key": "structureTensorSigma",
      "label": "Structure-tensor sigma (px)",
      "type": "float",
      "min": 0.5,
      "max": 20.0,
      "step": 0.1,
      "default": 2.0
    },
    {
      "key": "anisotropyBoxSize",
      "label": "Anisotropy box size (px)",
      "type": "int",
      "min": 5,
      "max": 200,
      "step": 1,
      "default": 45
    }
  ]
}
