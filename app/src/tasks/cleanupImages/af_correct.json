{
  "task": "afCorrect",
  "fun_name": "cleanupImages.afCorrect",
  "label": "AF correction",
  "category": "Cleanup",
  "env": [
    "local"
  ],
  "resource_pool": "cpu",
  "outputValueName": "afCorrected",
  "params": [
    {
      "key": "valueName",
      "label": "Image to correct",
      "type": "valueNameSelection",
      "default": "default",
      "field": "filepaths",
      "tip": "Select which image version to apply AF correction to"
    },
    {
      "key": "afCombinations",
      "label": "Channel combinations",
      "type": "group",
      "repeatable": true,
      "labelKey": "targetChannel",
      "default": {},
      "tip": "One entry per channel, with the channels it competes with",
      "params": [
        {
          "key": "targetChannel",
          "label": "Channel to correct",
          "type": "channelSelection",
          "multiple": false,
          "default": [],
          "tip": "The channel to correct"
        },
        {
          "key": "competingChannels",
          "label": "Competing channels",
          "type": "channelSelection",
          "multiple": true,
          "default": [],
          "tip": "Channels that share signal with this one"
        },
        {
          "key": "exclusive",
          "label": "Different cell types",
          "type": "bool",
          "default": true,
          "tip": "Turn off if cells can carry both markers"
        }
      ]
    },
    {
      "key": "backgroundMethod",
      "label": "Background detection",
      "type": "select",
      "default": "triangle",
      "options": [
        {
          "label": "Triangle",
          "value": "triangle"
        },
        {
          "label": "Otsu",
          "value": "otsu"
        }
      ],
      "tip": "How the background level of each channel is found"
    }
  ]
}
