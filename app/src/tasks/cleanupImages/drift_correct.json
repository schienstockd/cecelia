{
  "task": "driftCorrect",
  "fun_name": "cleanupImages.driftCorrect",
  "label": "Drift correction",
  "category": "Cleanup",
  "env": ["local"],
  "resource_pool": "cpu",
  "outputValueName": "driftCorrected",
  "requires": { "axes": ["T"] },
  "params": [
    {
      "key": "valueName",
      "label": "Image to correct",
      "type": "valueNameSelection",
      "default": "default",
      "field": "filepaths",
      "tip": "Select which image version to apply drift correction to"
    },
    {
      "key": "driftChannel",
      "label": "Drift reference channel",
      "type": "channelSelection",
      "multiple": false,
      "default": [],
      "tip": "Channel used for phase cross-correlation to estimate per-timepoint drift"
    },
    {
      "key": "driftNormalisation",
      "label": "Drift normalisation",
      "type": "select",
      "default": "none",
      "options": [
        { "label": "None",  "value": "none" },
        { "label": "Phase", "value": "phase" }
      ],
      "tip": "Normalisation of the phase cross-correlation"
    },
    {
      "key": "driftEstimator",
      "label": "Estimator",
      "type": "select",
      "default": "multiLag",
      "options": [
        { "label": "Multi-lag", "value": "multiLag" },
        { "label": "Chain",     "value": "chain" }
      ],
      "tip": "Multi-lag compares non-adjacent frames too, so one bad frame cannot offset the rest"
    },
    {
      "key": "driftMaxLag",
      "label": "Max frame gap",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 8,
      "step": 1,
      "tip": "How far apart two frames may be and still be compared — higher is more robust but slower"
    }
  ]
}
