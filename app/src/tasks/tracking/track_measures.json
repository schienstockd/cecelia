{
  "task": "trackMeasures",
  "fun_name": "tracking.track_measures",
  "label": "Track measures",
  "category": "Tracking",
  "env": ["local"],
  "resource_pool": "cpu",
  "requires": { "axes": ["T"] },
  "params": [
    {
      "key": "valueName",
      "label": "Tracks",
      "type": "valueNameSelection",
      "field": "labelPropsNames",
      "tip": "Which tracked cells to measure"
    },
    {
      "key": "dims",
      "label": "Motion dimensions",
      "type": "motionDimsSelection",
      "default": "auto",
      "tip": "Compute measures in 2D or 3D; auto detects and recommends"
    },
    {
      "key": "forceRecompute",
      "label": "Force recompute",
      "type": "bool",
      "default": true,
      "tip": "Recalculate even where measures already exist"
    }
  ]
}
