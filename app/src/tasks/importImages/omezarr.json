{
  "task": "omezarr",
  "fun_name": "importImages.omezarr",
  "label": "Convert to OME-ZARR",
  "category": "import",
  "env": [
    "local"
  ],
  "resource_pool": "io",
  "params": [
    {
      "key": "pyramidScale",
      "label": "Pyramid scale",
      "type": "int",
      "min": 1,
      "max": 10,
      "default": 2,
      "step": 1,
      "tip": "Downscaled copies for fast zoomed-out viewing; 2-3 suits a 512-1024 px frame"
    },
    {
      "key": "stageLocal",
      "label": "Copy to local scratch first",
      "type": "bool",
      "default": false,
      "tip": "Copy the source locally first \u2014 much faster over a network share"
    },
    {
      "key": "advanced",
      "label": "Advanced",
      "type": "section",
      "collapsed": true,
      "params": [
        {
          "key": "chunkSize",
          "label": "Chunk size",
          "type": "select",
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "Auto (recommended)"
            },
            {
              "value": "512",
              "label": "512 px"
            },
            {
              "value": "1024",
              "label": "1024 px"
            },
            {
              "value": "2048",
              "label": "2048 px"
            }
          ],
          "tip": "Zarr chunk shape in XY (--tile-width/height); auto = 1024, capped to the frame"
        },
        {
          "key": "ngffVersion",
          "label": "OME-NGFF version",
          "type": "select",
          "default": "0.4",
          "options": [
            {
              "value": "0.4",
              "label": "0.4 \u2014 zarr v2 (.zattrs/.zarray)"
            },
            {
              "value": "0.5",
              "label": "0.5 \u2014 zarr v3 (zarr.json), allows sharding"
            }
          ],
          "tip": "OME-NGFF spec version; 0.5 is zarr v3 (--ngff-version)",
          "defaultFrom": "zarr.ngffVersion"
        },
        {
          "key": "shardSize",
          "label": "Shard size (XY)",
          "type": "select",
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "Auto (1024)"
            },
            {
              "value": "512",
              "label": "512 px"
            },
            {
              "value": "2048",
              "label": "2048 px"
            }
          ],
          "tip": "NGFF 0.5 only; sharding_indexed packs chunks per file (--shard-width/height)"
        },
        {
          "key": "shardDepth",
          "label": "Shard depth (z)",
          "type": "select",
          "default": "1",
          "options": [
            {
              "value": "1",
              "label": "1 \u2014 no z packing (default)"
            },
            {
              "value": "all",
              "label": "All z \u2014 ~8x fewer files, see tip"
            }
          ],
          "tip": "NGFF 0.5 only (--shard-depth); spanning z rewrites a whole shard per plane write"
        }
      ]
    }
  ]
}
