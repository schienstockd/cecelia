{
  "task": "omezarr",
  "fun_name": "importImages.omezarr",
  "label": "Convert to OME-ZARR",
  "category": "import",
  "env": ["local"],
  "resource_pool": "io",
  "params": [
    {
      "key": "pyramidScale",
      "label": "Pyramid scale",
      "type": "int",
      "min": 1,
      "max": 10,
      "default": 2,
      "step": 1,
      "tip": "Resolution levels in the image pyramid."
    },
    {
      "key": "convertTo8bit",
      "label": "Convert to 8-bit",
      "type": "bool",
      "default": false,
      "tip": "Rescale 16-bit to 8-bit on import; the 16-bit is not kept."
    },
    {
      "key": "stageLocal",
      "label": "Copy to local scratch first",
      "type": "bool",
      "default": false,
      "tip": "Copy the source locally first — much faster over a network share."
    },
    {
      "key": "advanced",
      "label": "Advanced",
      "type": "section",
      "collapsed": true,
      "params": [
        {
          "key": "rescaleLowPercentile",
          "label": "8-bit low percentile",
          "type": "float",
          "min": 0,
          "max": 50,
          "default": 0,
          "step": 0.1,
          "tip": "Bottom of the 8-bit intensity window (0 = true minimum)."
        },
        {
          "key": "rescaleHighPercentile",
          "label": "8-bit high percentile",
          "type": "float",
          "min": 50,
          "max": 100,
          "default": 100,
          "step": 0.1,
          "tip": "Top of the 8-bit intensity window (100 = true maximum)."
        },
        {
          "key": "chunkSizeX",
          "label": "Chunk size X",
          "type": "int",
          "min": 64,
          "max": 2048,
          "default": 1024,
          "step": 64,
          "tip": "Zarr chunk size in X."
        },
        {
          "key": "chunkSizeY",
          "label": "Chunk size Y",
          "type": "int",
          "min": 64,
          "max": 2048,
          "default": 1024,
          "step": 64,
          "tip": "Zarr chunk size in the Y dimension."
        }
      ]
    }
  ]
}
