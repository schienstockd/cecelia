{
  "task": "clusterRegions",
  "fun_name": "clustRegions.cluster",
  "label": "Cluster regions",
  "category": "Spatial analysis",
  "env": ["local"],
  "resource_pool": "cpu",
  "scope": "set",
  "params": [
    {
      "key": "valueNameSuffix",
      "label": "Suffix",
      "type": "text",
      "default": "default",
      "tip": "Output suffix → regions.<suffix>"
    },
    {
      "key": "basisPops",
      "label": "Population basis",
      "type": "popSelection",
      "accepts": ["live", "clust", "region", "track", "trackclust"],
      "multiple": true,
      "acrossSegmentations": true,
      "default": [],
      "tip": "Populations defining neighbourhood composition; at least two"
    },
    {
      "key": "neighbourMethod",
      "label": "Graph type",
      "type": "select",
      "default": "delaunay",
      "options": [
        { "value": "delaunay", "label": "Delaunay (radius-pruned)" },
        { "value": "knn",      "label": "k nearest neighbours" },
        { "value": "radius",   "label": "Fixed radius" }
      ],
      "tip": "How the neighbourhood graph is built"
    },
    {
      "key": "neighbourRadius",
      "label": "Radius (µm)",
      "type": "float",
      "min": 0,
      "max": 1000,
      "step": 1,
      "default": 30,
      "tip": "Neighbourhood radius in microns (fixed-radius graph + Delaunay pruning)"
    },
    {
      "key": "nNeighbours",
      "label": "k (neighbours)",
      "type": "int",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 6,
      "tip": "Number of nearest neighbours for the kNN graph"
    },
    {
      "key": "clusterMethod",
      "label": "Clustering",
      "type": "select",
      "default": "leiden",
      "options": [
        { "value": "leiden", "label": "Leiden (resolution)" },
        { "value": "kmeans", "label": "k-means (fixed k)" }
      ],
      "tip": "Leiden (resolution-driven) or k-means (fixed count)"
    },
    {
      "key": "resolution",
      "label": "Resolution",
      "type": "float",
      "min": 0,
      "max": 5,
      "step": 0.05,
      "default": 1,
      "tip": "Leiden resolution — higher gives more, smaller regions"
    },
    {
      "key": "numClusters",
      "label": "Number of regions (k-means)",
      "type": "int",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 5,
      "tip": "Number of regions for k-means"
    },
    {
      "key": "perTimepoint",
      "label": "Per timepoint (live)",
      "type": "bool",
      "default": false,
      "tip": "Build the graph per frame, so regions can change over time"
    },
    {
      "key": "mergeUmap",
      "label": "Calculate UMAP",
      "type": "bool",
      "default": true,
      "tip": "Also compute a UMAP of the composition vectors (obsm['X_umap.<suffix>']) for plotting"
    }
  ]
}
