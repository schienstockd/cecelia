{
  "task": "clusterRegions",
  "fun_name": "clustRegions.cluster",
  "label": "Cluster regions",
  "category": "Spatial analysis",
  "env": ["local"],
  "resource_pool": "cpu",
  "scope": "set",
  "params": [
    {
      "key": "graphSuffix",
      "label": "Neighbour graph",
      "type": "valueNameSelection",
      "field": "spatialGraphs",
      "default": "default",
      "tip": "Which neighbour graph defines the neighbourhoods — run \"Neighbour graph\" first"
    },
    {
      "key": "valueNameSuffix",
      "label": "Suffix",
      "type": "valueNameInput",
      "namespace": "regions",
      "default": "default",
      "tip": "Output suffix → regions.<suffix>"
    },
    {
      "key": "basisPops",
      "required": true,
      "requiredMessage": "Select the population basis — what defines the neighbourhood",
      "label": "Population basis",
      "type": "popSelection",
      "accepts": ["live", "clust", "region", "track", "trackclust"],
      "multiple": true,
      "acrossSegmentations": true,
      "default": [],
      "tip": "Populations defining neighbourhood composition; at least two"
    },
    {
      "key": "includeOther",
      "label": "Count other cells",
      "type": "bool",
      "default": true,
      "tip": "Count graph neighbours outside the basis as an \"other\" fraction"
    },
    {
      "key": "clusterMethod",
      "label": "Clustering",
      "type": "select",
      "default": "leiden",
      "options": [
        { "value": "leiden", "label": "Leiden (resolution)" },
        { "value": "kmeans", "label": "k-means (fixed k)" }
      ],
      "tip": "Leiden (resolution-driven) or k-means (fixed count)"
    },
    {
      "key": "resolution",
      "label": "Resolution",
      "type": "float",
      "min": 0.05,
      "max": 5,
      "step": 0.05,
      "default": 1,
      "tip": "Leiden resolution — higher gives more, smaller regions"
    },
    {
      "key": "numClusters",
      "label": "Number of regions (k-means)",
      "type": "int",
      "min": 2,
      "max": 50,
      "step": 1,
      "default": 5,
      "tip": "Number of regions for k-means"
    },
    {
      "key": "mergeUmap",
      "label": "Calculate UMAP",
      "type": "bool",
      "default": true,
      "tip": "Also compute a UMAP of the composition vectors (obsm['X_umap.<suffix>']) for plotting"
    }
  ]
}
