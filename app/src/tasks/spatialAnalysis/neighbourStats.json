{
  "task": "neighbourStats",
  "fun_name": "spatialAnalysis.neighbourStats",
  "label": "Contact statistics",
  "category": "Spatial analysis",
  "env": ["local"],
  "resource_pool": "cpu",
  "params": [
    {
      "key": "statsSuffix",
      "label": "Suffix",
      "type": "text",
      "default": "default",
      "tip": "Output suffix → spatialStats/<suffix>.json"
    },
    {
      "key": "basisPops",
      "label": "Populations",
      "type": "popSelection",
      "accepts": ["live", "clust", "region", "track", "trackclust"],
      "multiple": true,
      "acrossSegmentations": true,
      "default": [],
      "tip": "Cell types for pairwise contact statistics; at least two"
    },
    {
      "key": "neighbourMethod",
      "label": "Graph type",
      "type": "select",
      "default": "delaunay",
      "options": [
        { "value": "delaunay", "label": "Delaunay (radius-pruned)" },
        { "value": "knn",      "label": "k nearest neighbours" },
        { "value": "radius",   "label": "Fixed radius" }
      ],
      "tip": "How the neighbour graph is built"
    },
    {
      "key": "neighbourRadius",
      "label": "Radius (µm)",
      "type": "float",
      "min": 0,
      "max": 1000,
      "step": 1,
      "default": 30,
      "tip": "Neighbourhood radius in microns (fixed-radius graph + Delaunay pruning)"
    },
    {
      "key": "nNeighbours",
      "label": "k (neighbours)",
      "type": "int",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 6,
      "tip": "Number of nearest neighbours for the kNN graph"
    }
  ]
}
