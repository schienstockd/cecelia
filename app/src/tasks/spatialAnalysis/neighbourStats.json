{
  "task": "neighbourStats",
  "fun_name": "spatialAnalysis.neighbourStats",
  "label": "Interaction matrix",
  "category": "Spatial analysis",
  "env": [
    "local"
  ],
  "resource_pool": "cpu",
  "params": [
    {
      "key": "graphSuffix",
      "label": "Neighbour graph",
      "type": "valueNameSelection",
      "field": "spatialGraphs",
      "default": "default",
      "tip": "Which neighbour graph to analyse \u2014 run \"Neighbour graph\" first"
    },
    {
      "key": "statsSuffix",
      "label": "Name",
      "type": "text",
      "default": "default",
      "tip": "Output name \u2192 spatialStats/<name>.json"
    },
    {
      "key": "basisPops",
      "label": "Populations",
      "type": "popSelection",
      "accepts": [
        "live",
        "clust",
        "region",
        "track",
        "trackclust"
      ],
      "multiple": true,
      "acrossSegmentations": true,
      "default": [],
      "tip": "Cell types to test for pairwise association; at least two"
    },
    {
      "key": "nPermutations",
      "label": "Permutations",
      "type": "int",
      "min": 0,
      "max": 10000,
      "step": 100,
      "default": 1000,
      "tip": "Random relabellings for the significance test; 0 skips it"
    }
  ]
}
