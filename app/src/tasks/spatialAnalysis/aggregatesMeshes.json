{
  "task": "aggregatesMeshes",
  "fun_name": "spatialAnalysis.aggregatesMeshes",
  "label": "Detect aggregates (meshes)",
  "category": "Spatial analysis",
  "env": ["local"],
  "resource_pool": "cpu",
  "requires": { "scale": ["xy"] },
  "params": [
    {
      "key": "pops",
      "required": true,
      "requiredMessage": "Select a population",
      "label": "Population",
      "type": "popSelection",
      "accepts": ["live", "clust", "region", "track", "trackclust"],
      "multiple": true,
      "acrossSegmentations": false,
      "default": [],
      "tip": "The population to detect aggregates of"
    },
    {
      "key": "maxClusterDist",
      "label": "Surface distance (µm)",
      "type": "float",
      "min": 0,
      "max": 50,
      "step": 0.5,
      "default": 5,
      "tip": "Surface-to-surface distance (µm) that links two cells"
    },
    {
      "key": "minCells",
      "label": "Min cells",
      "type": "int",
      "min": 2,
      "max": 100,
      "step": 1,
      "default": 5,
      "tip": "Minimum number of connected cells for a group to count as an aggregate"
    }
  ]
}
