{
  "task": "cellNeighbours",
  "fun_name": "spatialAnalysis.cellNeighbours",
  "label": "Neighbour graph",
  "methodsText": ["A neighbour graph of {pops} cells was built", {"showIf": {"neighbourMethod": "delaunay"}, "text": " by Delaunay triangulation, with edges longer than {neighbourRadius} removed"}, {"showIf": {"neighbourMethod": "radius"}, "text": " from cells within {neighbourRadius}"}, {"showIf": {"neighbourMethod": "knn"}, "text": " from each cell's {nNeighbours} nearest neighbours"}, {"showIf": {"neighbourMethod": "windows"}, "text": " in {windowSize} windows"}, "."],
  "purpose": "Build the neighbour graph that interaction and region steps read",
  "useWhen": [
    "Before Interaction matrix or Cluster regions: both need this graph",
    "Live imaging: per timepoint links cells only within one frame",
    "Fixed windows: regions as places on a grid, not around each cell"
  ],
  "notWhen": [],
  "category": "Spatial analysis",
  "group": "Neighbourhood",
  "env": ["local"],
  "resource_pool": "cpu",
  "sweep": { "output": "graphSuffix", "params": ["neighbourRadius", "nNeighbours", "windowSize"] },
  "requires": { "scale": ["xy"] },
  "params": [
    {
      "key": "graphSuffix",
      "label": "Name",
      "type": "valueNameInput",
      "namespace": "spatialGraphs",
      "default": "default",
      "tip": "Output name → spatialGraph/<name>.h5ad"
    },
    {
      "key": "pops",
      "label": "Cells",
      "type": "popSelection",
      "accepts": ["live", "clust", "region", "track", "trackclust"],
      "multiple": true,
      "acrossSegmentations": true,
      "default": [],
      "tip": "Cells to connect — select each segmentation's \"all\" root for a reusable graph"
    },
    {
      "key": "neighbourMethod",
      "label": "Graph type",
      "type": "select",
      "default": "delaunay",
      "options": [
        { "value": "delaunay", "label": "Delaunay (radius-pruned)" },
        { "value": "knn",      "label": "k nearest neighbours" },
        { "value": "radius",   "label": "Fixed radius" },
        { "value": "windows",  "label": "Fixed windows" }
      ],
      "tip": "Delaunay (radius-pruned), kNN, fixed radius, or a grid of overlapping square windows"
    },
    {
      "key": "neighbourRadius",
      "label": "Radius (µm)",
      "unit": "um",
      "type": "float",
      "min": 0,
      "max": 200,
      "step": 1,
      "default": 30,
      "showIf": { "neighbourMethod": ["delaunay", "radius"] },
      "tip": "Neighbourhood radius in µm; also prunes Delaunay edges"
    },
    {
      "key": "nNeighbours",
      "label": "k (neighbours)",
      "type": "int",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 6,
      "showIf": { "neighbourMethod": "knn" },
      "tip": "Number of nearest neighbours for the kNN graph"
    },
    {
      "key": "windowSize",
      "label": "Window size (µm)",
      "unit": "um",
      "type": "float",
      "min": 5,
      "max": 500,
      "step": 1,
      "default": 50,
      "showIf": { "neighbourMethod": "windows" },
      "tip": "Side of each square window; windows overlap by half"
    },
    {
      "key": "advanced",
      "label": "Advanced",
      "type": "section",
      "collapsed": true,
      "params": [
        {
          "key": "perTimepoint",
          "label": "Per timepoint",
          "type": "bool",
          "default": true,
          "showIf": { "neighbourMethod": ["delaunay", "knn", "radius"] },
          "tip": "Link cells only within the same frame; off = pool all frames"
        }
      ]
    }
  ]
}
