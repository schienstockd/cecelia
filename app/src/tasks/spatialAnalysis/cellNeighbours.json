{
  "task": "cellNeighbours",
  "fun_name": "spatialAnalysis.cellNeighbours",
  "label": "Neighbour graph",
  "category": "Spatial analysis",
  "env": ["local"],
  "resource_pool": "cpu",
  "params": [
    {
      "key": "pops",
      "label": "Populations",
      "type": "popSelection",
      "accepts": ["live", "clust", "region", "track", "trackclust"],
      "multiple": true,
      "acrossSegmentations": false,
      "default": [],
      "tip": "Cells to connect into a spatial neighbour graph."
    },
    {
      "key": "neighbourMethod",
      "label": "Graph type",
      "type": "select",
      "default": "delaunay",
      "options": [
        { "value": "delaunay", "label": "Delaunay (radius-pruned)" },
        { "value": "knn",      "label": "k nearest neighbours" },
        { "value": "radius",   "label": "Fixed radius" }
      ],
      "tip": "Delaunay (radius-pruned), kNN, or fixed radius."
    },
    {
      "key": "neighbourRadius",
      "label": "Radius (µm)",
      "type": "float",
      "min": 0,
      "max": 1000,
      "step": 1,
      "default": 30,
      "tip": "Neighbourhood radius in µm; also prunes Delaunay edges."
    },
    {
      "key": "nNeighbours",
      "label": "k (neighbours)",
      "type": "int",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 6,
      "tip": "Number of nearest neighbours for the kNN graph."
    }
  ]
}
