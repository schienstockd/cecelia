{
  "task": "cellNeighbours",
  "fun_name": "spatialAnalysis.cellNeighbours",
  "label": "Neighbour graph",
  "category": "Spatial analysis",
  "env": ["local"],
  "resource_pool": "cpu",
  "params": [
    {
      "key": "graphSuffix",
      "label": "Name",
      "type": "text",
      "default": "default",
      "tip": "Output name → spatialGraph/<name>.h5ad"
    },
    {
      "key": "pops",
      "label": "Cells",
      "type": "popSelection",
      "accepts": ["live", "clust", "region", "track", "trackclust"],
      "multiple": true,
      "acrossSegmentations": true,
      "default": [],
      "tip": "Cells to connect — select each segmentation's \"all\" root for a reusable graph"
    },
    {
      "key": "neighbourMethod",
      "label": "Graph type",
      "type": "select",
      "default": "delaunay",
      "options": [
        { "value": "delaunay", "label": "Delaunay (radius-pruned)" },
        { "value": "knn",      "label": "k nearest neighbours" },
        { "value": "radius",   "label": "Fixed radius" }
      ],
      "tip": "Delaunay (radius-pruned), kNN, or fixed radius"
    },
    {
      "key": "neighbourRadius",
      "label": "Radius (µm)",
      "type": "float",
      "min": 0,
      "max": 200,
      "step": 1,
      "default": 30,
      "tip": "Neighbourhood radius in µm; also prunes Delaunay edges"
    },
    {
      "key": "nNeighbours",
      "label": "k (neighbours)",
      "type": "int",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 6,
      "tip": "Number of nearest neighbours for the kNN graph"
    },
    {
      "key": "perTimepoint",
      "label": "Per timepoint",
      "type": "bool",
      "default": false,
      "tip": "Link cells only within the same frame (live imaging)"
    }
  ]
}
