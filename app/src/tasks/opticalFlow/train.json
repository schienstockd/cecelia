{
  "task": "trainFlowModel",
  "fun_name": "opticalFlow.train",
  "label": "Train flow model",
  "category": "Optical flow",
  "env": [
    "local"
  ],
  "resource_pool": "gpu",
  "scope": "set",
  "params": [
    {
      "key": "valueName",
      "label": "Images to train on",
      "type": "valueNameSelection",
      "default": "default",
      "tip": "Usually the smoothed version — flow needs a denoised input"
    },
    {
      "key": "modelName",
      "label": "Model name",
      "type": "text",
      "default": "",
      "tip": "Saved to the vault under this name"
    },
    {
      "key": "trainChannels",
      "label": "Channels",
      "type": "channelSelection",
      "multiple": true,
      "default": [],
      "tip": "Channels carrying the cell signal; merged by maximum"
    },
    {
      "key": "zPlanes",
      "label": "Z planes",
      "type": "int",
      "min": 1,
      "max": 25,
      "step": 1,
      "default": 1,
      "tip": "Evenly-spaced planes per movie; each multiplies the frames pooled"
    },
    {
      "key": "temporalScales",
      "label": "Temporal scales",
      "type": "chipSelect",
      "default": [
        "1",
        "2",
        "4",
        "8"
      ],
      "tip": "Frame lags; inference must reuse these",
      "options": [
        {
          "label": "1",
          "value": "1"
        },
        {
          "label": "2",
          "value": "2"
        },
        {
          "label": "3",
          "value": "3"
        },
        {
          "label": "4",
          "value": "4"
        },
        {
          "label": "6",
          "value": "6"
        },
        {
          "label": "8",
          "value": "8"
        },
        {
          "label": "12",
          "value": "12"
        },
        {
          "label": "16",
          "value": "16"
        }
      ]
    },
    {
      "key": "cumulativeWindow",
      "label": "Cumulative window",
      "type": "int",
      "min": 2,
      "max": 51,
      "step": 1,
      "default": 5,
      "tip": "Frames summed for total displacement"
    },
    {
      "key": "flowMetrics",
      "label": "Metrics",
      "type": "chipSelect",
      "multiple": true,
      "default": [
        "acceleration",
        "cell_boundary_likelihood",
        "cumulative_mag",
        "direction_stability",
        "edge_strength",
        "normal_flow",
        "strain",
        "tangential_flow"
      ],
      "tip": "Planes the model reads; add the per-scale magnitudes automatically",
      "options": [
        {
          "label": "acceleration",
          "value": "acceleration"
        },
        {
          "label": "cell_boundary_likelihood",
          "value": "cell_boundary_likelihood"
        },
        {
          "label": "cumulative_mag",
          "value": "cumulative_mag"
        },
        {
          "label": "direction_stability",
          "value": "direction_stability"
        },
        {
          "label": "divergence",
          "value": "divergence"
        },
        {
          "label": "edge_strength",
          "value": "edge_strength"
        },
        {
          "label": "flow_structure_alignment",
          "value": "flow_structure_alignment"
        },
        {
          "label": "normal_flow",
          "value": "normal_flow"
        },
        {
          "label": "strain",
          "value": "strain"
        },
        {
          "label": "tangential_flow",
          "value": "tangential_flow"
        },
        {
          "label": "vorticity",
          "value": "vorticity"
        }
      ]
    },
    {
      "key": "epochs",
      "label": "Epochs",
      "type": "int",
      "min": 1,
      "max": 500,
      "step": 5,
      "default": 30,
      "tip": "Training passes over the movie"
    },
    {
      "key": "overwrite",
      "label": "Overwrite existing",
      "type": "bool",
      "default": false,
      "tip": "Replace a model of the same name in the vault"
    },
    {
      "key": "advanced",
      "label": "Advanced",
      "type": "section",
      "collapsed": true,
      "params": [
        {
          "key": "foregroundWeight",
          "label": "Foreground loss",
          "type": "float",
          "min": 0.0,
          "max": 10.0,
          "step": 0.5,
          "default": 1.0,
          "tip": "Supervises the probability head at cell scale"
        },
        {
          "key": "intensityWeight",
          "label": "Intensity loss",
          "type": "float",
          "min": 0.0,
          "max": 10.0,
          "step": 0.5,
          "default": 1.0,
          "tip": "Per-pixel brightness target; lower it if the mask fragments"
        },
        {
          "key": "temporalWeight",
          "label": "Temporal loss",
          "type": "float",
          "min": 0.0,
          "max": 10.0,
          "step": 0.5,
          "default": 2.0,
          "tip": "Pulls the embedding together along the flow"
        },
        {
          "key": "embeddingDim",
          "label": "Embedding size",
          "type": "int",
          "min": 4,
          "max": 64,
          "step": 4,
          "default": 16,
          "tip": "Width of the embedding the region growing runs on"
        },
        {
          "key": "normalise",
          "label": "Normalise percentile",
          "type": "float",
          "min": 50.0,
          "max": 100.0,
          "step": 0.01,
          "default": 99.99,
          "tip": "Upper percentile for intensity normalisation"
        }
      ]
    }
  ]
}
