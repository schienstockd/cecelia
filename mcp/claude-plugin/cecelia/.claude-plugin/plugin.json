{
  "name": "cecelia",
  "displayName": "Cecelia",
  "version": "1.0.0",
  "description": "The Cecelia observer tools, and a hook that records which model made each call",
  "author": { "name": "Cecelia" },
  "license": "GPL-3.0-or-later",
  "userConfig": {
    "python":     { "type": "string", "title": "Python", "description": "The Cecelia install's Python interpreter", "required": true },
    "mcp_dir":    { "type": "string", "title": "MCP folder", "description": "The install's mcp/ folder", "required": true },
    "pythonpath": { "type": "string", "title": "PYTHONPATH", "description": "mcp/ then python/ of the same install", "required": true },
    "api_url":    { "type": "string", "title": "Cecelia API", "description": "Loopback URL of the running Cecelia", "required": true },
    "token_file": { "type": "string", "title": "API token file", "description": "Path to the API token file, never the token", "required": true }
  },
  "mcpServers": {
    "cecelia-observer": {
      "command": "${user_config.python}",
      "args": ["-m", "cecelia_mcp.server"],
      "env": {
        "PYTHONPATH": "${user_config.pythonpath}",
        "CECELIA_API_URL": "${user_config.api_url}",
        "CECELIA_API_TOKEN_FILE": "${user_config.token_file}"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(plugin_cecelia_)?cecelia-(observer|autonomous)__.*",
        "hooks": [
          { "type": "command", "command": "${user_config.python}",
            "args": ["-I", "${user_config.mcp_dir}/cecelia_mcp/caller_hook.py"] }
        ]
      }
    ]
  }
}
