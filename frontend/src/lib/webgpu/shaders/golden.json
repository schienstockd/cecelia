{
  "_about": "Hand-derived expectations for the WGSL expander and the uniform layouts. BOTH hosts test against this file — shaderSource.test.ts (browser) and python/cecelia/tests/test_wgsl_utils.py (movie host) — so passing on both means they expand and pack identically. Expected values are worked out by hand from the rules in shaderSource.ts, not generated by either implementation.",
  "expand": [
    {
      "name": "include with a variable argument, then a constant",
      "files": {
        "main.wgsl": "#include \"inc.wgsl\" B=MAX_CHANNELS\nlet a = ${A};\n",
        "inc.wgsl": "// inc\nlet b = ${B};\n"
      },
      "vars": {
        "A": 0.45,
        "MAX_CHANNELS": 32
      },
      "out": "// inc\nlet b = 32;\nlet a = 0.45;\n"
    },
    {
      "name": "include with a literal argument, indented",
      "files": {
        "main.wgsl": "fn f() {\n  #include \"inc.wgsl\" B=7\n}\n",
        "inc.wgsl": "let b = ${B};\n"
      },
      "vars": {},
      "out": "fn f() {\nlet b = 7;\n}\n"
    },
    {
      "name": "the includer's variables reach the included file",
      "files": {
        "main.wgsl": "#include \"inc.wgsl\"\n",
        "inc.wgsl": "@binding(${PICK_BINDING}) ${N}u\n"
      },
      "vars": {
        "PICK_BINDING": 5,
        "N": 65536
      },
      "out": "@binding(5) 65536u\n"
    },
    {
      "name": "an integral float prints without its .0; a fraction prints shortest",
      "files": {
        "main.wgsl": "${X} ${Y} ${Z}\n"
      },
      "vars": {
        "X": 2.0,
        "Y": 0.0001,
        "Z": 1.5
      },
      "out": "2 0.0001 1.5\n"
    },
    {
      "name": "a string variable is inserted verbatim (generated code)",
      "files": {
        "main.wgsl": "switch i {\n${ARMS}\n}\n"
      },
      "vars": {
        "ARMS": "    case 0u: { return 1u; }\n    default: { return 2u; }"
      },
      "out": "switch i {\n    case 0u: { return 1u; }\n    default: { return 2u; }\n}\n"
    },
    {
      "name": "an undefined variable is an error",
      "files": {
        "main.wgsl": "let a = ${NOPE};\n"
      },
      "vars": {},
      "error": true
    },
    {
      "name": "an include cycle is an error",
      "files": {
        "main.wgsl": "#include \"inc.wgsl\"\n",
        "inc.wgsl": "#include \"main.wgsl\"\n"
      },
      "vars": {},
      "error": true
    }
  ],
