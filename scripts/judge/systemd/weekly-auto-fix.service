[Unit]
Description=Weekly judge — work the bugs verify called `fix`, one sandboxed session and PR each
Documentation=file://%h/.cecelia-effectiveness/judge-worktree/docs/ai-assist/WEEKLY_JUDGE.md
# Started by weekly-judge.service's OnSuccess=, never by a timer: it works the record that pass wrote.
ConditionACPower=true

[Service]
Type=oneshot
# Same worktree, PATH and cron lock as weekly-judge.service (cron_pass.sh `--auto`). Each session
# bootstraps its own fix worktree, so pixi and npm need the network from here, not from the agent.
Environment=REPO=%h/.cecelia-effectiveness/judge-worktree
Environment=PATH=%h/.pixi/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -c 'exec "$${REPO}/scripts/judge/cron_pass.sh" --auto'
# Sessions run one after another, each waiting on its PR's CI: hours for a full queue. A session killed
# mid-way leaves its worktree and the bug `left`, so the limit is generous rather than tight.
TimeoutStartSec=20h
StandardOutput=journal
StandardError=journal
